<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Reset MuJoCo Sim">
  <BehaviorTree
    ID="Reset MuJoCo Sim"
    _description="Release command controllers, reset the stock arm and parked contact fixture, then restore the previous controllers. A failed reset remains a failure."
  >
    <Control ID="Sequence">
      <Action
        ID="ListControllers"
        type="command"
        state="active"
        controller_list="{command_controllers}"
        service_name="/controller_manager/list_controllers"
      />
      <Action
        ID="SwitchController"
        deactivate_controllers="{command_controllers}"
      />
      <Control ID="Fallback">
        <Control ID="Sequence">
          <Action
            ID="ResetMujocoKeyframe"
            keyframe_name="{keyframe_name}"
            response_timeout="10"
            wait_for_server_available_timeout="3"
          />
          <Action
            ID="SwitchController"
            activate_controllers="{command_controllers}"
          />
        </Control>
        <Control ID="Sequence">
          <Action
            ID="SwitchController"
            activate_controllers="{command_controllers}"
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Reset MuJoCo Sim">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="MuJoCo Simulation" />
      </MetadataFields>
      <input_port name="keyframe_name" default="default" type="std::string">
        Installed MuJoCo keyframe; contact_smoke places the fixed 50 mm block
        between the raised open jaws. Use only in simulation.
      </input_port>
    </SubTree>
  </TreeNodesModel>
</root>
