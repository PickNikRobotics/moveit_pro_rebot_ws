  <joint name="gripper_joint2" type="prismatic">
    <origin xyz="-0.041939 7.3385E-05 0" rpy="-1.5708 -1.5708 0" />
    <parent link="gripper_end" />
    <child link="gripper_right" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.04328416544945937" effort="500" velocity="0.024" />
    <mimic joint="joint7" multiplier="0.008" offset="0" />
  </joint>
  <link name="gripper_motor_frame" />
  <joint name="joint7" type="revolute">
    <parent link="gripper_end" />
    <child link="gripper_motor_frame" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="5.410520681182422" velocity="3.0" effort="14" />
  </joint>
  <link name="world" />
  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="${world_to_base_xyz}" rpy="${world_to_base_rpy}" />
  </joint>
  <xacro:property name="arm_mode" value="${dict(motion='motion', position_csp='position_csp')['$(arg arm_control_mode)']}" />
  <xacro:macro name="rebot_joint" params="name id model kp kd mode:=${arm_mode}">
    <joint name="${name}">
      <xacro:if value="${'$(arg hardware_interface)' == 'real'}">
        <param name="id">${id}</param>
      </xacro:if>
      <command_interface name="position" />
      <xacro:if value="${'$(arg hardware_interface)' == 'mock'}">
        <command_interface name="velocity" />
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <xacro:if value="${'$(arg hardware_interface)' == 'real'}">
      <gpio name="${name}_motor">
        <param name="type">robstride</param>
        <param name="ID">${id}</param>
        <param name="actuator_type">${model}</param>
        <param name="can_interface">$(arg can_interface)</param>
        <param name="control_mode">${mode}</param>
        <param name="kp">${kp}</param>
        <param name="kd">${kd}</param>
      </gpio>
    </xacro:if>
  </xacro:macro>
  <xacro:if value="${hardware_plugin != ''}">
    <ros2_control name="RebotSystem" type="system">
      <hardware>
        <plugin>${hardware_plugin}</plugin>
        <xacro:if value="${'$(arg hardware_interface)' == 'mock'}">
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:if value="${'$(arg hardware_interface)' == 'real'}">
          <param name="master_id">253</param>
          <param name="number_of_joints">7</param>
          <param name="hold_torque_on_deactivate">true</param>
          <param name="motor_can_timeout_ms">0</param>
          <param name="freeze_on_joint_loss">true</param>
          <param name="torque_enable">$(arg torque_enable)</param>
        </xacro:if>
      </hardware>
      <xacro:rebot_joint name="joint1" id="1" model="RS06" kp="50.0" kd="3.0" />
      <xacro:rebot_joint name="joint2" id="2" model="RS06" kp="150.0" kd="10.0" />
      <xacro:rebot_joint name="joint3" id="3" model="RS06" kp="150.0" kd="10.0" />
      <xacro:rebot_joint name="joint4" id="4" model="RS00" kp="50.0" kd="5.0" />
      <xacro:rebot_joint name="joint5" id="5" model="RS00" kp="50.0" kd="4.0" />
      <xacro:rebot_joint name="joint6" id="6" model="RS00" kp="50.0" kd="4.0" />
      <xacro:rebot_joint name="joint7" id="7" model="RS00" kp="12.0" kd="0.05" mode="motion" />
    </ros2_control>
  </xacro:if>
  <xacro:if value="${'$(arg hardware_interface)' == 'mujoco'}">
    <ros2_control name="RebotMujocoSystem" type="system">
      <hardware>
        <plugin>picknik_mujoco_ros/MujocoSystem</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="mujoco_model_package">$(arg mujoco_model_package)</param>
        <param name="mujoco_keyframe">$(arg mujoco_keyframe)</param>
        <param name="mujoco_viewer">$(arg mujoco_viewer)</param>
        <param name="render_publish_rate">0</param>
        <param name="point_cloud_publish_rate">0</param>
        <param name="tf_publish_rate">60</param>
      </hardware>
    </ros2_control>
  </xacro:if>
</robot>
