<?xml version="1.0"?>
<!-- Derived from Seeed reBot-DevArm, CERN-OHL-W-2.0. Modified by PickNik Inc., 2026: stock visuals, motor-coordinate limits/J7 jaw coupling, backend selectors and identity world placement. Original SolidWorks exporter: Stephen Brawner, 1.6.0-4-g7f85cfe, build 1.6.7995.38578; http://wiki.ros.org/sw_urdf_exporter. See NOTICE.md. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rebot_b601_rs">
  <xacro:arg name="mujoco_viewer" default="false" />
  <xacro:arg name="mujoco_keyframe" default="default" />
  <xacro:arg name="mujoco_model_package" default="" />
  <xacro:arg name="mujoco_model" default="description/scene.xml" />
  <xacro:arg name="hardware_interface" default="mock" />
  <xacro:arg name="can_interface" default="can0" />
  <xacro:arg name="torque_enable" default="true" />
  <xacro:arg name="arm_control_mode" default="motion" />
  <xacro:arg name="world_to_base_xyz" default="0 0 0" />
  <xacro:arg name="world_to_base_rpy" default="0 0 0" />
  <xacro:property name="world_to_base_xyz" default="$(arg world_to_base_xyz)" />
  <xacro:property name="world_to_base_rpy" default="$(arg world_to_base_rpy)" />
  <xacro:property name="hardware_plugins" value="${dict(mock='mock_components/GenericSystem', real='robstride_hardware_interface/RobstrideHardware', mujoco='')}" />
  <xacro:property name="hardware_plugin" value="${hardware_plugins['$(arg hardware_interface)']}" />
