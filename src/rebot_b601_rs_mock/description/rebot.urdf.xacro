  </link>
  <joint name="j_gripper_end" type="fixed">
    <origin xyz="0 0 0.16621" rpy="3.1416 -1.5708 0" />
    <parent link="link6" />
    <child link="gripper_end" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="gripper_left">
    <inertial>
      <origin xyz="-0.00218008703135955 0.0187090355934181 0.00932188568692145" rpy="0 0 0" />
      <mass value="0.0752" />
      <inertia ixx="1.09877964176176E-05" ixy="0" ixz="0" iyy="9.50146036720166E-06" iyz="0" izz="9.30779991911125E-06" />
    </inertial>
