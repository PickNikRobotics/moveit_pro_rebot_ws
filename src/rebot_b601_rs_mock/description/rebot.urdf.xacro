      </geometry>
      <material name="rs_anodized_silver" />
    </visual>
  </link>
  <joint name="gripper_joint1" type="prismatic">
    <origin xyz="-0.041939 -7.3385E-05 0" rpy="1.5708 -1.5708 0" />
    <parent link="gripper_end" />
    <child link="gripper_left" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.04328416544945937" effort="500" velocity="0.024" />
    <mimic joint="joint7" multiplier="0.008" offset="0" />
  </joint>
  <link name="gripper_right">
    <inertial>
      <origin xyz="0.00218008703135955 -0.018709035593418 0.00932188568692151" rpy="0 0 0" />
      <mass value="0.0752" />
      <inertia ixx="1.09877964176176E-05" ixy="0" ixz="0" iyy="9.50146036720166E-06" iyz="0" izz="9.30779991911125E-06" />
    </inertial>
