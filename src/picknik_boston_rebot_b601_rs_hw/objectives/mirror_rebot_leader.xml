<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Mirror reBot Leader">
  <BehaviorTree
    ID="Mirror reBot Leader"
    _description="Engage, end any gravity-comp float (JTAC re-anchors at the measured pose and the configured spring gains return), then mirror calibrated FashionStar positions with native FCL collision checks. Stop returns HOME, restores the normal trajectory controller, then runs Relax at HOME; a refused relax keeps torque on at HOME."
  >
    <Sequence name="EngagePrepareThenMirror">
      <Action
        ID="CallTriggerService"
        service_name="/robstride_hardware_interface/engage"
        wait_for_server_available_timeout="3.0"
        response_timeout="3.0"
      />
      <!-- Engage while already ON keeps runtime gains: end any gravity-comp
           float (kp=0) at the measured pose before anything else moves. -->
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_admittance_controller"
        automatic_deactivation="true"
        strictness="2"
      />
      <SubTree ID="reBot Set Spring Gains" _collapsed="true" />
      <Action
        ID="CallRebotLeaderService"
        service_name="/rebot_leader_bridge/prepare"
      />
      <Action
        ID="SwitchController"
        activate_controllers="leader_position_controller"
        automatic_deactivation="true"
        strictness="2"
      />
      <Repeat num_cycles="-1">
        <Sequence>
          <Action
            ID="CallRebotLeaderService"
            service_name="/rebot_leader_bridge/mirror"
          />
          <Action ID="WaitForDuration" delay_duration="0.05" />
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Mirror reBot Leader">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot Bench" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
