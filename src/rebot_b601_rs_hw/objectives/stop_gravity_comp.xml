<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Stop Gravity Comp">
  <BehaviorTree
    ID="Stop Gravity Comp"
    _description="Make JTAC the arm position owner (ending a jog or leader controller), re-anchor the supported reBot arm at its measured pose before restoring configured spring gains, then finish. The configured gravity compensation stays active. Retains torque; does not move HOME or disable motors."
  >
    <Control ID="Sequence" name="stop_gravity_comp">
      <!-- Teleoperation jog modes and Mirror leave another position owner
           active. Make JTAC the owner first; its measured-pose anchor follows. -->
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_admittance_controller"
        automatic_deactivation="true"
        strictness="2"
      />
      <SubTree ID="reBot Set Spring Gains" _collapsed="true" />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Stop Gravity Comp">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
