<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Start Gravity Comp">
  <BehaviorTree
    ID="Start Gravity Comp"
    _description="Make JTAC the arm position owner (ending a jog or leader controller), re-anchor the supported reBot arm at its measured pose, switch spring gains to damped float, then finish. The configured gravity compensation must be active and stays active. Use Stop Gravity Comp to restore spring gains; attended, thermally protected use only."
  >
    <Control ID="Sequence" name="start_gravity_comp">
      <!-- Teleoperation jog modes and Mirror leave another position owner
           active. Make JTAC the owner first; its measured-pose anchor follows. -->
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_admittance_controller"
        automatic_deactivation="true"
        strictness="2"
      />
      <SubTree ID="reBot Set Float Gains" _collapsed="true" />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Start Gravity Comp">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
