<?xml version="1.0" encoding="UTF-8" ?>
<root
  BTCPP_format="4"
  main_tree_to_execute="Calibrate reBot Wrist Camera Intrinsics"
>
  <BehaviorTree
    ID="Calibrate reBot Wrist Camera Intrinsics"
    _description="Calibrate the intrinsics of the Gemini 305 wrist camera at the calibration waypoints and check them against the factory camera_info the driver publishes. Run Generate reBot Calibration Waypoints first. See https://docs.picknik.ai/how_to/robotics_applications/camera_calibration/."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <SubTree
        ID="Calibrate Camera Intrinsics"
        _collapsed="true"
        use_waypoints="true"
        waypoint_prefix="calibration"
        image_topic="/wrist_mounted_camera/color/image_raw"
        camera_info_topic="/wrist_mounted_camera/color/camera_info"
        camera_name="wrist_mounted_camera"
        joint_group_name="manipulator"
        end_effector_frame="gripper_end"
        base_frame="base_link"
        board="{board}"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Calibrate reBot Wrist Camera Intrinsics">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Perception - Camera Calibration" />
      </MetadataFields>
      <input_port
        name="board"
        default="[{squares_x: 7, squares_y: 5, square_length: 0.05, marker_length: 0.037143, dictionary: DICT_4X4_50}]"
        type="moveit_studio_msgs::msg::CharucoBoard"
      >
        The ChArUco board in view. Match your print: squares along x and y,
        square and marker side lengths in meters, dictionary.
      </input_port>
    </SubTree>
  </TreeNodesModel>
</root>
