<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Relax at HOME">
  <BehaviorTree
    ID="Relax at HOME"
    _description="End any gravity-comp float (engage, make JTAC the arm owner, re-anchor at the measured pose and restore configured spring gains), complete Return HOME under power, verify the leader is idle, then request guarded torque-off from the running driver. The driver verifies the named pose, health and measured/commanded stillness; the Objective/caller must quiesce active and queued motion. A failed engage, gain restore, HOME, idle check or relax request fails this Objective; it never bypasses the guard."
  >
    <Sequence name="HomeThenRelax">
      <SubTree ID="reBot Check Leader Idle" _collapsed="true" />
      <!-- A floating arm (Start Gravity Comp) sags out of the HOME box and
           never settles, so the driver refuses relax. Stiffen first, at the
           measured pose, as Stop Gravity Comp does; then HOME. -->
      <Action
        ID="CallTriggerService"
        service_name="/robstride_hardware_interface/engage"
        wait_for_server_available_timeout="3.0"
        response_timeout="3.0"
      />
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_admittance_controller"
        automatic_deactivation="true"
        strictness="2"
      />
      <SubTree ID="reBot Set Spring Gains" _collapsed="true" />
      <SubTree ID="Return reBot Leader Home" _collapsed="true" />
      <!-- HOME closes the jaw last. Allow a complete stillness window after it;
           the driver still owns measured admission and may refuse the request. -->
      <Action ID="WaitForDuration" delay_duration="@HOME_SETTLE@" />
      <SubTree ID="reBot Check Leader Idle" _collapsed="true" />
      <Action
        ID="CallTriggerService"
        service_name="/robstride_hardware_interface/relax"
        wait_for_server_available_timeout="3.0"
        response_timeout="3.0"
      />
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Relax at HOME">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
